	<Name>HOGpmaIndirectCostMatrix</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Indirect cost matrix: selects the indirect component group of an hour line
/// from the worker's employment category and cost center.
/// An empty employment category or cost center applies to all, as in the standard
/// indirect cost assignment rules (<c>PSAComponentGroupAssignment</c>).
/// </summary>
public class HOGpmaIndirectCostMatrix extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks that the employment category exists and that the cost center is a value of the cost center dimension.
    /// </summary>
    /// <returns>true if the record is valid; otherwise, false.</returns>
    public boolean validateWrite()
    {
        boolean                     ret = super();
        BenefitEmploymentCategory   category;

        if (this.EmploymentCategory)
        {
            select firstonly RecId from category
                where category.EmploymentCategory == this.EmploymentCategory;

            if (!category.RecId)
            {
                ret = checkFailed(strFmt("@HOGpma:ErrValueNotFound",
                    tableId2PName(tableNum(BenefitEmploymentCategory)), this.EmploymentCategory));
            }
        }

        if (this.CostCenter && !HOGpmaIndirectCostMatrixLookup::checkCostCenter(this.CostCenter))
        {
            ret = false;
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
