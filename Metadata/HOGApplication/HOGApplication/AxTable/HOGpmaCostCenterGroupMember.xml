	<Name>HOGpmaCostCenterGroupMember</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Assigns a cost center (value of the cost center dimension) to one cost center group.
/// </summary>
public class HOGpmaCostCenterGroupMember extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the group assignment of a cost center.
    /// </summary>
    /// <param name = "_costCenter">The cost center value.</param>
    /// <param name = "_forUpdate">true to select the record for update.</param>
    /// <returns>The assignment, or an empty buffer.</returns>
    public static HOGpmaCostCenterGroupMember find(DimensionValue _costCenter, boolean _forUpdate = false)
    {
        HOGpmaCostCenterGroupMember member;

        if (_costCenter)
        {
            member.selectForUpdate(_forUpdate);

            select firstonly member
                where member.CostCenter == _costCenter;
        }

        return member;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
